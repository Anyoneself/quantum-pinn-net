# macOS metadata
.DS_Store
.AppleDouble
.LSOverride

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Editors
.idea/
.vscode/
*.swp
*.swo

# Logs and temporary workspaces
*.log
*.tmp
/tmp/

# Transient slide-generation state
defense_ppt_rba_qpinn/.slide_jobs.json.lock
defense_ppt_rba_qpinn/.slide_run_state.json.lock
*.paper_results_backup.pptx

# Reproducible experiment artifacts: keep summaries and figures, ignore bulky
# model checkpoints and NumPy intermediates generated by experiment runs.
experiments/*/seed_*/processed/*.npy
experiments/*/seed_*/runs/**/model.pt
experiments/*/seed_*/runs/**/*.npy

# Fixed inputs required to verify the supplementary experiment archive.
!experiments/rba_qpinn_submission_v1/seed_42/processed/fields.npy
!experiments/rba_qpinn_submission_v1/seed_42/processed/conditions.npy

# Third-party reading copies stay local; publish notes and source metadata.
output/pdf/chinese_core_references/
paper/materical/literature_sources/*.txt
!paper/materical/literature_sources/*_bibtex.txt
