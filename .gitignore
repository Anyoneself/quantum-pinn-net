# macOS metadata
.DS_Store
.AppleDouble
.LSOverride

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Python environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Editors
.idea/
.vscode/
*.swp
*.swo

# Logs and temporary workspaces
*.log
*.tmp
/tmp/

# Transient slide-generation state
v2/ppt/defense_ppt_rba_qpinn/.slide_jobs.json.lock
v2/ppt/defense_ppt_rba_qpinn/.slide_run_state.json.lock
*.paper_results_backup.pptx

# 模型权重、输入场和原始预测数组保留本地，远端只发布轻量证据。
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.npy
*.npz
*.h5
*.hdf5

# 逐步训练记录、原始检查点与高维核诊断表不进入 Git。
v[123]/experiments/**/history.json
v[123]/experiments/**/records.json
v3/ntk/runs/**/field_*/
v3/ntk/runs/**/records.json
v3/ntk/runs/**/analysis/checkpoint_metrics.csv
v3/ntk/runs/**/analysis/eigenspectra.csv
v3/ntk/runs/**/analysis/frequency_responses.csv
v3/ntk/runs/**/analysis/loss_kernel_blocks.csv
v3/ntk/runs/*smoke*/

# 整个汇报文件夹及PPT导出保留本地，论文图件仍可跟踪。
*.pptx
ppt/

# Third-party reading copies stay local; publish notes and source metadata.
v2/paper/output/pdf/chinese_core_references/
v2/paper/materical/literature_sources/*.txt
!v2/paper/materical/literature_sources/*_bibtex.txt
